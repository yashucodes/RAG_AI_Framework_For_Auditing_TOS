{
  "manifest_version": 3,
  "name": "ToS Legal Auditor",
  "version": "1.0",
  "description": "Audits Terms of Service on any webpage against Indian Laws.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}